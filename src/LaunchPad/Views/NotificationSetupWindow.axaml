<Window x:Class="LaunchPad.Views.NotificationSetupWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Notification channel" Width="500" Height="650" MinWidth="380" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource WindowBg}">
  <DockPanel Margin="24">
    <StackPanel DockPanel.Dock="Bottom" Spacing="8" Margin="0,12,0,0">
      <TextBlock x:Name="StatusText" Classes="HintText" TextWrapping="Wrap"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Classes="GhostButton" Click="Cancel_Click"/>
        <Button x:Name="SaveChannelButton" Content="Save channel" Classes="PrimaryButton" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="10">
        <TextBlock Text="Your notification channel" Classes="TitleText"/>
        <TextBlock Text="Use your own provider. LaunchPad needs no messaging account. Saving checks the setup format; it sends no test message." Classes="HintText" TextWrapping="Wrap"/>
        <ComboBox x:Name="ProviderBox" HorizontalAlignment="Stretch" SelectionChanged="Provider_Changed"/>
        <StackPanel x:Name="EmailPanel" Spacing="8">
          <TextBlock Text="Your email address" Classes="BodyText"/><TextBox x:Name="FromBox" Watermark="you@gmail.com" TextChanged="SenderEmail_Changed"/>
          <TextBlock Text="LaunchPad sends notifications from this address back to the same address." Classes="HintText" TextWrapping="Wrap"/>
          <TextBlock Text="Email service" Classes="BodyText"/><ComboBox x:Name="EmailServiceBox" HorizontalAlignment="Stretch" SelectionChanged="EmailService_Changed"/>
          <TextBlock x:Name="EmailPresetHint" Classes="HintText" TextWrapping="Wrap"/>
          <Button x:Name="EmailSignInHelpButton" Content="Open provider sign-in help" Classes="GhostButton" HorizontalAlignment="Left" IsVisible="False" Click="EmailSignInHelp_Click"/>
          <TextBlock Text="SMTP password or app password" Classes="BodyText"/><TextBox x:Name="PasswordBox" PasswordChar="●"/>
          <TextBlock Text="When your provider supports app passwords, generate a separate one named LaunchPad. Enter that instead of your normal account password. You can revoke it at your provider when you stop using notifications." Classes="HintText" TextWrapping="Wrap"/>
          <Expander x:Name="AdvancedEmailSettings" Header="Server settings" HorizontalAlignment="Stretch" IsExpanded="True">
            <StackPanel Spacing="8" Margin="0,8,0,0">
              <TextBlock Text="SMTP server" Classes="BodyText"/><TextBox x:Name="HostBox" Watermark="smtp.example.com" TextChanged="ServerIdentity_Changed"/>
              <TextBlock Text="Port" Classes="BodyText"/><TextBox x:Name="PortBox" Text="587"/>
              <TextBlock Text="Encryption (required)" Classes="BodyText"/><ComboBox x:Name="SecurityBox" HorizontalAlignment="Stretch"/>
              <TextBlock Text="SMTP username" Classes="BodyText"/><TextBox x:Name="UserBox" TextChanged="ServerIdentity_Changed"/>
              <TextBlock Text="Known services fill these fields automatically. You can edit them, or choose a service for a custom-domain account. Saving setup sends no message." Classes="HintText" TextWrapping="Wrap"/>
            </StackPanel>
          </Expander>
        </StackPanel>
        <StackPanel x:Name="TokenPanel" Spacing="8">
          <TextBlock x:Name="TokenLabel" Classes="BodyText"/><TextBox x:Name="TokenBox" PasswordChar="●"/>
        </StackPanel>
        <StackPanel x:Name="TelegramPanel" Spacing="8">
          <TextBlock Text="Chat ID or channel @username" Classes="BodyText"/><TextBox x:Name="ChatBox"/>
          <TextBlock Text="Create a bot using Telegram's BotFather, start its chat, and use your chat ID. This sends alerts only; phone replies are not connected to your agent." Classes="HintText" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="DiscordPanel" Spacing="8">
          <TextBlock Text="Discord webhook URL" Classes="BodyText"/><TextBox x:Name="WebhookBox" PasswordChar="●"/>
          <TextBlock Text="Create a webhook for your chosen Discord channel. Anyone with that webhook URL can post to it." Classes="HintText" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel x:Name="NtfyPanel" Spacing="8">
          <TextBlock Text="HTTPS server" Classes="BodyText"/><TextBox x:Name="ServerBox" Watermark="https://ntfy.sh"/>
          <TextBlock Text="Topic" Classes="BodyText"/><TextBox x:Name="TopicBox"/>
          <TextBlock Text="Subscribe to the same server/topic in the ntfy app. A public topic may be readable by others; use a private topic with access controls for privacy. An access token is optional when your server permits anonymous publishing." Classes="HintText" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Text="Credentials stay encrypted on this Windows account. Alerts contain the project name, agent, run and brief outcome—no project files or chat transcript." Classes="HintText" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

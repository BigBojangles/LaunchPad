<Window x:Class="LaunchPad.Views.WelcomeDialog"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchPad"
        Width="500" SizeToContent="Height" MaxHeight="600"
        CanResize="True" MinWidth="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <DockPanel Margin="28">
        <Button DockPanel.Dock="Bottom"
                Classes="PrimaryButton"
                Content="Continue"
                HorizontalAlignment="Right"
                IsDefault="True"
                Click="GotIt_Click"
                Margin="0,20,0,0"/>

        <CheckBox x:Name="DontShowCheck"
                  DockPanel.Dock="Bottom"
                  Classes="CheckLabel"
                  Content="Don't show this again"/>

        <TextBlock x:Name="WarningText"
                   Classes="BodyText"
                   TextWrapping="Wrap"
                   Text="New Project creates a folder, then lets you choose an agent and Fenced VM or Native mode. VM agents work on a copy; native Windows agents work directly in your folder using your account permissions. Native agents must already be installed. Your projects stay listed on the left."/>
    </DockPanel>
</Window>

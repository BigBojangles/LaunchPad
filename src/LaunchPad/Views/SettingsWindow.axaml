<Window x:Class="LaunchPad.Views.SettingsWindow" xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="440" Height="500" MinWidth="360" MinHeight="400" ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{StaticResource WindowBg}">
  <DockPanel Margin="28">
    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Classes="HintText"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
        <Button Content="Cancel" Classes="GhostButton" Click="Cancel_Click"/>
        <Button x:Name="SaveButton" Content="Save" Classes="PrimaryButton" Click="Save_Click"/>
      </StackPanel>
    </StackPanel>
    <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="12">
        <TextBlock Text="Settings" Classes="TitleText"/>
        <CheckBox x:Name="TipsSwitch" Content="Show one-time tips"/>
        <Button x:Name="ResetTipsButton" Content="Reset tips" Classes="GhostButton" HorizontalAlignment="Left" Click="ResetTips_Click"/>
        <TextBlock Text="Default agent" Classes="BodyText"/>
        <ComboBox x:Name="DefaultAgentBox" HorizontalAlignment="Stretch"/>
        <TextBlock Text="VM memory default" Classes="BodyText"/>
        <ComboBox x:Name="MemoryBox" HorizontalAlignment="Stretch"/>
        <TextBlock Text="VM CPU default" Classes="BodyText"/>
        <ComboBox x:Name="CoresBox" HorizontalAlignment="Stretch"/>
        <TextBlock x:Name="DefaultsHint" Text="Defaults apply next time a VM opens. Project choices stay in the project menu." Classes="HintText"/>
        <CheckBox x:Name="RememberSignInSwitch" Content="Reuse Grok sign-in for new VM projects"/>
        <TextBlock Text="Keeps an encrypted login cache for your Windows account. Turning this off stops sharing the login with new projects; existing VMs keep their own sign-in." Classes="HintText" TextWrapping="Wrap"/>
        <Button x:Name="SetupRepairButton" Content="Repair setup…" Classes="GhostButton" HorizontalAlignment="Left" Click="RepairSetup_Click"/>
        <TextBlock Text="Notifications" Classes="BodyText" Margin="0,12,0,0"/>
        <CheckBox x:Name="NotificationsSwitch" Content="Enable optional agent alerts"/>
        <TextBlock x:Name="NotificationsHint" Classes="HintText" TextWrapping="Wrap"/>
        <Button x:Name="ConfigureNotificationsButton" Content="Configure channel…" Classes="GhostButton" HorizontalAlignment="Left" Click="ConfigureNotifications_Click"/>
        <Button x:Name="NotificationHistoryButton" Content="View alert history" Classes="GhostButton" HorizontalAlignment="Left" Click="NotificationHistory_Click"/>
        <TextBlock Text="Preview: agent event reporting is still being connected, so current sessions may produce no alerts. After enabling, turn alerts on for each project from its folder menu. Silence or closing a process does not mean a run finished. Background delivery continues after this window closes while alerts are enabled. Sleep and being offline can delay or prevent delivery." Classes="HintText" TextWrapping="Wrap"/>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>

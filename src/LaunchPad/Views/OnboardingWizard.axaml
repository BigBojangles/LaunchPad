<Window x:Class="LaunchPad.Views.OnboardingWizard"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchPad setup"
        Width="560" Height="660"
        MinHeight="560" MinWidth="520"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBg}">
    <DockPanel Margin="28">
        <DockPanel DockPanel.Dock="Bottom" Margin="0,18,0,0">
            <Button x:Name="BackButton"
                    DockPanel.Dock="Left"
                    Classes="GhostButton"
                    Content="Back"
                    Click="Back_Click"
                    IsVisible="False"/>
            <Button x:Name="PrimaryButton"
                    Classes="PrimaryButton"
                    Content="Get started"
                    HorizontalAlignment="Right"
                    IsDefault="True"
                    Click="Primary_Click"/>
        </DockPanel>

        <TextBlock x:Name="StepLabel"
                   DockPanel.Dock="Top"
                   Classes="HintText"
                   Text="Step 1 of 4"
                   Margin="0,0,0,12"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="StepWelcome">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Image Width="44" Height="44"
                               Source="avares://LaunchPad/Assets/launchpad-rocket.png"
                               Margin="0,0,12,0"/>
                        <TextBlock Text="Welcome"
                                   Classes="TitleText"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Classes="BodyText" Margin="0,0,0,12"
                               Text="Learn the project workflow by building a tiny checklist / to-do tracker with Agent Bob:"/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,6"
                               Text="• LaunchPad — The front door. Creates folders and opens your project."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,6"
                               Text="• Agent Bob — Your planning and teaching companion in the chat service you choose."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,14"
                               Text="• Your coding agent — Grok Build, Codex CLI, Claude Code, or a custom program. Works in a terminal window."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,14"
                               Text="You’ll choose your coding agent before the project opens."/>
                    <TextBlock Classes="HintText"
                               Text="Practice a small workflow: define the goal, review a plan, approve the build, then check the result. Add, check off and clear tasks; extras can wait."/>
                </StackPanel>

                <StackPanel x:Name="StepAgentBob" IsVisible="False">
                    <TextBlock Text="Set up Agent Bob"
                               Classes="TitleText"
                               Margin="0,0,0,14"/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,16"
                               Text="Choose where you want to talk to Bob. Your chat companion and coding agent can be from different providers."/>
                    <TextBlock Classes="HintText" Text="Chat companion" Margin="0,0,0,6"/>
                    <ComboBox x:Name="CompanionBox" HorizontalAlignment="Stretch" Margin="0,0,0,12"
                              SelectionChanged="Companion_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button x:Name="CopyInstructionsButton" Classes="CardButton" Click="CopyInstructions_Click" Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock x:Name="CopyLabel" Text="Copy full companion instructions" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="Keeps the teaching, planning, review and project-management guidance."
                                       Classes="HintText"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="InstructionCount" Classes="HintText" Margin="0,0,0,10"/>
                    <Button x:Name="OpenCompanionButton" Classes="CardButton" Click="OpenCompanion_Click" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="OpenCompanionLabel" Text="Open your chat" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="CompanionAddress" Text="Opens the selected chat in your browser."
                                       Classes="HintText"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Button>
                    <TextBlock Classes="BodyText" Margin="0,0,0,12"
                               Text="1. Copy the full instructions. 2. Open your chat and sign in if needed. 3. Paste them as the first message in a new conversation. Bob will ask about your project and coding tool. Keep that conversation open, then continue here."/>
                    <TextBlock Classes="HintText" Margin="0,0,0,8"
                               Text="Optional: save the full instructions in your provider's project/custom instructions if that field accepts them. Field sizes and availability vary. If they do not fit, paste the same full instructions into a new chat."/>
                    <Button x:Name="CompanionHelpButton" Classes="QuietLink" Content="Provider instructions help" Click="OpenCompanionHelp_Click" Margin="0,0,0,8"/>
                    <Expander Header="Read the full companion instructions" Margin="0,0,0,10">
                        <TextBox x:Name="InstructionsPreview" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="240"/>
                    </Expander>
                    <TextBlock Classes="HintText" Margin="0,0,0,10"
                               Text="LaunchPad does not change your chat settings or send messages for you. For a fresh chat, paste the instructions again unless you saved them there."/>
                    <Button Classes="QuietLink" Content="Open project documentation" Click="OpenGuide_Click"/>
                </StackPanel>

                <StackPanel x:Name="StepCreateProject" IsVisible="False">
                    <TextBlock Text="Create your first project"
                               Classes="TitleText"
                               Margin="0,0,0,14"/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,14"
                               Text="Create a folder, then choose its agent and launch mode. You can change those choices later from the project menu."/>
                    <TextBlock x:Name="RunModeHint" Classes="HintText" Margin="0,0,0,14" Text="VM agents work on a copy. Native agents work directly in the Windows folder using your account permissions."/>
                    <TextBlock Classes="HintText" Margin="0,0,0,6" Text="Project name"/>
                    <TextBox x:Name="ProjectNameBox"
                             Classes="FieldBox"
                             Text="my-checklist"
                             TextChanged="ProjectName_TextChanged"/>
                    <TextBlock x:Name="ProjectPathPreview"
                               Classes="HintText"
                               Margin="0,10,0,0"/>
                    <TextBlock x:Name="ProjectError"
                               Foreground="{StaticResource Danger}"
                               FontSize="13"
                               Margin="0,8,0,8"
                               TextWrapping="Wrap"/>
                    <Button x:Name="UseExistingButton"
                            Classes="GhostButton"
                            Content="Use this project &amp; continue"
                            HorizontalAlignment="Left"
                            Click="UseExisting_Click"
                            IsVisible="False"
                            Margin="0,0,0,12"/>
                    <TextBlock Classes="HintText" Margin="0,0,0,10"
                               Text="Start with a small, clear first project. A tiny checklist is enough. You can always make another one later."/>
                    <TextBlock Classes="HintText" Margin="0,0,0,8"
                               Text="Your agent may ask you to sign in with its provider. Native mode uses an agent already installed on Windows."/>
                    <TextBlock Classes="HintText"
                               Text="Your project may need development tools or dependencies before it can build."/>
                </StackPanel>

                <StackPanel x:Name="StepNext" IsVisible="False">
                    <TextBlock Text="What to do next"
                               Classes="TitleText"
                               Margin="0,0,0,14"/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,12"
                               Text="This is the working loop:"/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,6"
                               Text="1. Describe your checklist project to Bob in your chosen chat."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,6"
                               Text="2. Copy Bob's planning prompt into your chosen coding agent. Bring its plan back to Bob and review it."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,14"
                               Text="3. Approve the plan, then use Bob's implementation prompt. Bring back results or errors and check the checklist together."/>
                    <TextBlock Classes="BodyText" Margin="0,0,0,10"
                               Text="The project folder is saved and launch has been requested. Check the agent terminal for sign-in, readiness or errors, and leave it open while you work."/>
                    <TextBlock Classes="HintText" Margin="0,0,0,6"
                               Text="First, paste this to Agent Bob so that he can help you plan the project:"/>
                    <Border Background="{StaticResource CardBg}"
                            BorderBrush="{StaticResource BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,0,0,10">
                        <TextBox x:Name="StarterPromptBox"
                                 TextWrapping="Wrap"
                                 IsReadOnly="True"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="13"
                                 Foreground="{StaticResource TextPrimary}"
                                 Text="i want to make a very small personal daily checklist app. one simple window. i can type a new item and add it. i can check items off when im done. i can clear the ones that are finished. nothing else for the first version. no saving between restarts yet. keep it really small so it can be built in one go."/>
                    </Border>
                    <TextBlock Classes="HintText" Margin="0,0,0,10"
                               Text="Done means you can add a task, check it off and clear completed tasks while unfinished tasks remain. This first version does not save between restarts."/>
                    <Button x:Name="CopyStarterButton"
                            Classes="GhostButton"
                            Content="Copy starter prompt"
                            HorizontalAlignment="Left"
                            Click="CopyStarter_Click"
                            Margin="0,0,0,14"/>
                    <Button Classes="GhostButton"
                            Content="Open project documentation"
                            HorizontalAlignment="Left"
                            Click="OpenGuide_Click"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</Window>

<Window x:Class="LaunchPad.Views.MachineWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Machine"
        Width="440"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <DockPanel Margin="28">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Classes="GhostButton" Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
            <Button Classes="PrimaryButton" Content="Save" IsDefault="True" Click="Save_Click"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Machine" Classes="TitleText" Margin="0,0,0,8"/>
            <TextBlock x:Name="BodyText"
                       Text="Used on the next open. A machine that is already running keeps its memory and cores."
                       Classes="HintText"
                       Margin="0,0,0,16"/>
            <TextBlock Text="Memory" Classes="HintText" Margin="0,0,0,6"/>
            <ComboBox x:Name="MemoryBox" FontSize="15" Padding="8,6" Margin="0,0,0,14"/>
            <StackPanel x:Name="CoresPanel">
                <TextBlock Text="Cores" Classes="HintText" Margin="0,0,0,6"/>
                <ComboBox x:Name="CoresBox" FontSize="15" Padding="8,6" Margin="0,0,0,4"/>
            </StackPanel>
            <TextBlock x:Name="StatusText" Classes="HintText" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
    </DockPanel>
</Window>

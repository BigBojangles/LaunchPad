<Window x:Class="LaunchPad.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchPad"
        Icon="avares://LaunchPad/Assets/LaunchPad.ico"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="NoChrome"
        ExtendClientAreaTitleBarHeightHint="0"
        CanResize="True"
        Height="720" Width="1080"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackground}"
        Foreground="{DynamicResource Ink}">

    <Grid>
        <!-- Full-width caption. Buttons and resize grips stay above this hit area. -->
        <Border x:Name="TitleDragArea" Height="52" VerticalAlignment="Top"
                Background="Transparent" ZIndex="3" PointerPressed="Window_MouseLeftButtonDown"/>
        <StackPanel Margin="0,20,28,0"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ZIndex="4">

            <Button Classes="CornerButton" Content="&#x2014;" ToolTip.Tip="Minimize" Click="Minimize_Click"/>
            <Button x:Name="MaximizeButton" Classes="CornerButton" Content="&#xE922;"
                    FontFamily="Segoe MDL2 Assets" ToolTip.Tip="Maximize" Click="Maximize_Click"/>
            <Button Classes="CornerButton" Content="&#x00D7;" FontSize="16" ToolTip.Tip="Close" Click="Close_Click"/>
        </StackPanel>
    <Grid Margin="36,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>





        <!-- Left: New Project, Projects divider, project bubbles (Views\ExistingProjectsView). -->
        <ContentControl x:Name="ProjectsHost"
                        Background="Transparent"
                        Grid.Column="0"
                        Focusable="False"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="0,48,0,0"/>

        <!-- Right: rocket, name, slogan, live session tiles, quiet links (Views\HomeView). -->
        <ContentControl x:Name="Host" Grid.Column="1" Focusable="False"/>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Classes="PadLink" Content="Casey Nielsen" Click="CaseyLink_RequestNavigate"/>
                <TextBlock Classes="CreditText" Text="  ·  " VerticalAlignment="Center"/>
                <Viewbox Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Path Fill="{DynamicResource Muted}"
                          Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.725-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
                </Viewbox>
                <Button Classes="PadLink" Content="@BigBojangles_" Click="CreditLink_RequestNavigate"/>
                <TextBlock Classes="CreditText" Text="  ·  " VerticalAlignment="Center"/>
                <Button Classes="PadLink" Content="GitHub" Click="GitHubLink_RequestNavigate"/>
            </StackPanel>
            <Button x:Name="SettingsButton" DockPanel.Dock="Left" Classes="CornerButton"
                    Content="&#xE713;" FontFamily="Segoe MDL2 Assets" ToolTip.Tip="Settings"
                    AutomationProperties.Name="Settings" Margin="0,0,12,0" VerticalAlignment="Center"
                    Click="Settings_Click"/>
            <Button x:Name="RetryButton"
                    DockPanel.Dock="Left"
                    Classes="NewProjectButton"
                    Content="Try again"
                    Width="96"
                    Height="28"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="RetryButton_Click"
                    IsVisible="False"/>
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{DynamicResource Muted}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="34"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text=""/>
        </DockPanel>
    </Grid>
    <!-- Native resize operations, with usable client-area grips for custom chrome. -->
    <Grid x:Name="ResizeHandles" ZIndex="5">
        <Border Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="Resize_PointerPressed"/>
        <Border Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="Resize_PointerPressed"/>
        <Border Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="Resize_PointerPressed"/>
        <Border Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="Resize_PointerPressed"/>
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="Resize_PointerPressed"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="Resize_PointerPressed"/>
        <Border Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="Resize_PointerPressed"/>
        <Border Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="Resize_PointerPressed"/>
    </Grid>
    </Grid>
</Window>

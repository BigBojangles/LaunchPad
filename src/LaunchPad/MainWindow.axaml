<Window x:Class="LaunchPad.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LaunchPad"
        Icon="avares://LaunchPad/Assets/LaunchPad.ico"
        SystemDecorations="None"
        CanResize="True"
        Height="720" Width="1080"
        MinHeight="400" MinWidth="620"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        Foreground="{StaticResource Ink}"
        PointerPressed="Window_MouseLeftButtonDown">

    <Grid Margin="36,20,28,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    ZIndex="2">
            <Button x:Name="SettingsButton" Classes="CornerButton" Content="⚙" ToolTip.Tip="Settings" Click="Settings_Click"/>
            <Button Classes="CornerButton" Content="&#x2014;" ToolTip.Tip="Minimize" Click="Minimize_Click"/>
            <Button Classes="CornerButton" Content="&#x00D7;" FontSize="16" ToolTip.Tip="Close" Click="Close_Click"/>
        </StackPanel>

        <!-- Left: New Project, Projects divider, project bubbles (Views\ExistingProjectsView). -->
        <ContentControl x:Name="ProjectsHost"
                        Grid.Column="0"
                        Focusable="False"
                        VerticalAlignment="Top"
                        HorizontalAlignment="Left"
                        Margin="0,48,0,0"/>

        <!-- Right: rocket, name, slogan, live session tiles, quiet links (Views\HomeView). -->
        <ContentControl x:Name="Host" Grid.Column="1" Focusable="False"/>

        <DockPanel Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Classes="PadLink" Content="Casey Nielsen" Click="CaseyLink_RequestNavigate"/>
                <TextBlock Classes="CreditText" Text="  ·  " VerticalAlignment="Center"/>
                <Viewbox Width="10" Height="10" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Path Fill="{StaticResource Muted}"
                          Data="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.744l7.725-8.835L1.254 2.25H8.08l4.253 5.622L18.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117L17.083 19.77z"/>
                </Viewbox>
                <Button Classes="PadLink" Content="@BigBojangles_" Click="CreditLink_RequestNavigate"/>
                <TextBlock Classes="CreditText" Text="  ·  " VerticalAlignment="Center"/>
                <Button Classes="PadLink" Content="GitHub" Click="GitHubLink_RequestNavigate"/>
            </StackPanel>
            <Button x:Name="RetryButton"
                    DockPanel.Dock="Left"
                    Classes="NewProjectButton"
                    Content="Try again"
                    Width="96"
                    Height="28"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Click="RetryButton_Click"
                    IsVisible="False"/>
            <TextBlock x:Name="StatusText"
                       FontSize="12"
                       Foreground="{StaticResource Muted}"
                       TextWrapping="Wrap"
                       TextTrimming="CharacterEllipsis"
                       MaxHeight="34"
                       Margin="0,0,16,0"
                       VerticalAlignment="Center"
                       Text=""/>
        </DockPanel>
    </Grid>
</Window>
